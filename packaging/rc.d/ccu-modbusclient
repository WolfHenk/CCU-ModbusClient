ADDON=ccu-modbusclient
BASE=/usr/local/addons/$ADDON
CONF=/usr/local/etc/config/addons/$ADDON/config.json
PIDFILE=/var/run/ccu-modbusclient.pid
case "$1" in
  # The OpenCCU addon page calls info.<language> AND info, then joins
  # matching fields. Emitting the full info twice duplicates name, version
  # and logo in the Systemsteuerung > Zusatzsoftware table.
  info.de|info.en)
    ;;
  info)
    echo 'Name: CCU-ModbusClient'
    echo "Version: $(cat "$BASE/VERSION" 2>/dev/null)"
    echo "Info: <div style='text-align:center'>"
    echo "Info: <img src='/addons/ccu-modbusclient/img/modbus-logo.png' style='max-width:235px;max-height:70px;margin:2px 0 5px 0' alt='Modbus'><br>"
    echo 'Info: <b>CCU-ModbusClient 0.3.3</b><br>'
    echo 'Info: Modbus-TCP-Client fuer CCU/OpenCCU<br><br>'
    echo "Info: <a href='https://github.com/WolfHenk/CCU-ModbusClient' target='_blank'>GitHub: CCU-ModbusClient</a>"
    echo 'Info: </div>'
    echo 'Config-Url: /addons/ccu-modbusclient/index.cgi'
    echo 'Operations: restart uninstall'
    ;;
  init)
    "$BASE/bin/register_interface" install
    [ -x "$BASE/bin/register_devtype" ] && "$BASE/bin/register_devtype" install
    ;;
  start)
    "$BASE/bin/register_interface" install || exit 1
    [ -x "$BASE/bin/register_devtype" ] && "$BASE/bin/register_devtype" install || exit 1
    [ -x "$BASE/bin/ccu-modbusclientd" ] || exit 1
    [ -f "$CONF" ] || exit 1
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    "$BASE/bin/ccu-modbusclientd" -config "$CONF" -check >/dev/null 2>&1 || exit 1
    "$BASE/bin/ccu-modbusclientd" -config "$CONF" -xmlrpc-listen 127.0.0.1:18702 >/var/log/ccu-modbusclient.log 2>&1 &
    echo $! > "$PIDFILE"
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
      PID=$(cat "$PIDFILE")
      kill "$PID" 2>/dev/null || true
      rm -f "$PIDFILE"
    fi
    ;;
  restart) "$0" stop; "$0" start ;;
  uninstall)
    # Removal leaves nothing behind. ReGa must remove our devices and the
    # interface object first; if that fails, nothing else is removed so the
    # uninstall can simply be repeated.
    # 1. Delete in ReGa while the daemon still runs: ReGa asks it
    #    (reportValueUsage) for every datapoint it removes.
    if [ -x "$BASE/bin/ccu-modbusclientd" ]; then
      "$BASE/bin/ccu-modbusclientd" -purge-ccu || exit 1
    fi
    "$0" stop
    i=0
    while [ -n "$(pidof ccu-modbusclientd)" ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
    [ -n "$(pidof ccu-modbusclientd)" ] && exit 1
    # 2. Repeat after the stop in case anything was announced meanwhile;
    #    without leftovers this is a no-op.
    if [ -x "$BASE/bin/ccu-modbusclientd" ]; then
      "$BASE/bin/ccu-modbusclientd" -purge-ccu || exit 1
    fi
    if [ -x "$BASE/bin/register_devtype" ]; then
      "$BASE/bin/register_devtype" remove || exit 1
    fi
    if [ -x "$BASE/bin/update_addon" ]; then
      "$BASE/bin/update_addon" delete "$ADDON" || exit 1
    fi
    if [ -x "$BASE/bin/register_interface" ]; then
      "$BASE/bin/register_interface" remove || exit 1
    fi
    rm -f /usr/local/etc/config/addons/www/$ADDON
    rm -rf "$BASE"
    rm -rf "/usr/local/etc/config/addons/$ADDON"
    rm -f "$PIDFILE" /var/log/ccu-modbusclient.log /usr/local/tmp/ccu-modbusclient-*.json
    ;;
  *) exit 1 ;;
esac
exit 0
